# Local/secret config — never commit real credentials.
# application.yml / application-local.yml themselves ARE committed (the
# local profile only ever holds throwaway dev-only secrets); this is for
# anything a developer adds locally on top of them.
.env
.env.*
application-local-override.yml
*.jks
*.p12
*.pem

# Claude Code local session state (machine/session-specific, not shared config)
.claude/settings.local.json
.claude/scheduled_tasks.lock
CLAUDE.local.md
